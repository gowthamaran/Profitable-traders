# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------
# "demo"       serves the synthetic dataset with a site-wide DEMO DATA banner.
# "production" serves only approved records from the database, and shows
#              INSUFFICIENT VERIFIABLE DATA wherever none exists.
# Unset: demo when DATABASE_URL is absent, production when it is present.
DATA_MODE=demo

# ---------------------------------------------------------------------------
# Database (required for production mode)
# ---------------------------------------------------------------------------
# Any Postgres. Apply db/schema.sql before first run.
DATABASE_URL=
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Admin / research console
# ---------------------------------------------------------------------------
# 32+ random characters. Without it /api/admin/review is disabled, so no
# statistic can be approved. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Source adapters (all optional; an unconfigured adapter reports that it
# cannot run rather than returning a partial number)
# ---------------------------------------------------------------------------
DUNE_API_KEY=
FLIPSIDE_API_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
