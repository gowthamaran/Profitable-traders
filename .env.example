# Required -------------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Chats allowed to command the bot. Space or comma separated. Send /whoami to
# the bot to learn a chat id. The bot refuses to start without this.
ALLOWED_CHAT_IDS=
# Where unattended scan output goes. Defaults to the first allowed chat.
BROADCAST_CHAT_ID=

# Strongly recommended -------------------------------------------------------
# The public RPC is rate limited and will throttle the holder reads. Any
# Helius/QuickNode/Triton endpoint works.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional -------------------------------------------------------------------
# Without this the CT flood check and the culture scan report that they did
# not run, rather than guessing.
TWITTER_BEARER_TOKEN=

# Schedule -------------------------------------------------------------------
TRENCH_INTERVAL_SECONDS=600
SECONDARY_INTERVAL_SECONDS=1800
CULTURE_INTERVAL_SECONDS=7200
TRENCH_ENABLED=true
SECONDARY_ENABLED=true
# Off until you turn it on, per the brief.
CULTURE_ENABLED=false

# Reporting ------------------------------------------------------------------
MAX_CALLS_PER_REPORT=3
REPEAT_SUPPRESSION_HOURS=24
CT_FLOOD_THRESHOLD=25

# Trench filter --------------------------------------------------------------
TRENCH_BONDED_MIN_PCT=30
TRENCH_BONDED_MAX_PCT=70
TRENCH_REQUIRE_MINT_REVOKED=true
TRENCH_REQUIRE_FREEZE_REVOKED=true
TRENCH_MAX_TOP_HOLDER_PCT=25
TRENCH_TOP_HOLDER_DEPTH=10
TRENCH_MIN_BUY_SELL_RATIO=1.3
TRENCH_MIN_TXNS=30
TRENCH_MAX_AGE_HOURS=48

# Secondary filter -----------------------------------------------------------
SECONDARY_MIN_AGE_DAYS=7
SECONDARY_MIN_MCAP_USD=2000000
SECONDARY_MAX_MCAP_USD=25000000
SECONDARY_MIN_LP_RATIO=0.03
SECONDARY_MIN_LP_USD=80000
SECONDARY_MIN_VOL_RECOVERY=1.2

# Runtime --------------------------------------------------------------------
CANDIDATE_POOL_SIZE=60
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_CONCURRENCY=8
STATE_PATH=state/sri_wagmi.sqlite3
LOG_LEVEL=INFO
